{
  "cleanUrls": true,
  "redirects": [
    { "source": "/index-ar", "destination": "/ar", "permanent": true },
    { "source": "/index-ar.html", "destination": "/ar", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
